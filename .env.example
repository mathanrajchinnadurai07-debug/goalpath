# GoalPath Environment Configuration Example
# Copy this file to .env and supply your environment values

# Database (PostgreSQL 16 - Neon / Supabase / Self-Hosted)
DATABASE_URL=""

# Application Security
APP_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Redis (Sessions & Distributed Rate Limiting - Upstash TLS or Redis 7/8)
REDIS_URL=""

# Email Delivery (Resend / SMTP)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="GoalPath <notifications@goalpath.app>"

# Cloudflare Turnstile / Bot Protection (Optional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# AI Coach Engine (Opt-in)
AI_COACH_API_KEY=""
AI_COACH_PROVIDER="mock"
